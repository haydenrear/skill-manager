{
  "require": [
    {
      "id": "names-the-epic",
      "tool": "Bash",
      "match": "ticket\\s+sweep\\b.*--(?:epic|target)[=\\s]+[\\\\\\\"']*(?:epic/)?trim-docs"
    }
  ],
  "forbid": [
    {
      "id": "no-bare-or-manual",
      "tool": "Bash",
      "match": "ticket\\s+sweep\\b(?!.*--(?:epic|target)).*(?:--yes|\\s-y\\b)|git\\s+worktree\\s+remove"
    }
  ],
  "max_calls": {
    "Bash": 4
  }
}
