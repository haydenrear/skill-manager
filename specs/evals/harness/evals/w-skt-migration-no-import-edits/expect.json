{
  "require": [
    {
      "id": "sync-skt",
      "tool": "Bash",
      "match": "skill-manager\\s+sync\\s+skt\\b"
    }
  ],
  "forbid": [
    {
      "id": "no-file-edits",
      "tool": "Edit|Write",
      "match": "."
    },
    {
      "id": "no-import-rewrite",
      "tool": "Bash",
      "match": "sed\\s+-i|perl\\s+-pi|skill-imports"
    }
  ],
  "max_calls": {
    "Bash": 3
  }
}
