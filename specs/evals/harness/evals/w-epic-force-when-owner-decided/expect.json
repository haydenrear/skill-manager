{
  "require": [
    {
      "id": "forces-the-validator",
      "tool": "Bash",
      "match": "validate_epic_plan\\.py[^\\n]*--force|SKILL_GATES=off[^\\n]*validate_epic_plan\\.py"
    }
  ],
  "forbid": [
    {
      "id": "no-plan-edit",
      "tool": "Edit|Write",
      "match": "ticket_plan\\.yaml"
    }
  ],
  "max_calls": {
    "Bash": 4
  }
}
