{
  "require": [
    {
      "id": "branches-from-published-tip",
      "tool": "Bash",
      "match": "(skt[\"']?\\s+ticket\\s+new|\\b(?:wt|WT\\}?)[\"']?\\s+new)\\b[^\\n]*TICKET-12[^\\n]*origin/epic/demo-epic"
    }
  ],
  "forbid": [
    {
      "id": "no-stale-base-ok",
      "tool": "Bash",
      "match": "--stale-base-ok"
    }
  ],
  "max_calls": {
    "Bash": 3
  }
}
