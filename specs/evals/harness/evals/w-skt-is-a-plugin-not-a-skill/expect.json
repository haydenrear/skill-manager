{
  "require": [
    {
      "id": "checked-the-cli",
      "tool": "Bash|Glob|Read",
      "match": "bin/cli/skt|bin/cli/\\*|bin/cli\\b|command\\s+-v\\s+skt|which\\s+skt|skt\\s+(?:--version|--help|status)"
    }
  ],
  "forbid": [
    {
      "id": "no-manual-route",
      "tool": "Bash",
      "match": "git\\s+worktree\\s+add|bootstrap-home\\.sh(?!\\s+--help)"
    }
  ]
}
