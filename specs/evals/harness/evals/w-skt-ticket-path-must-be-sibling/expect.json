{
  "require": [
    {
      "id": "sibling-path",
      "tool": "Bash",
      "match": "--path[=\\s]+[\\\\\\\"']*\\.\\./wt-12-trim-readme"
    }
  ],
  "forbid": [
    {
      "id": "inside-repo",
      "tool": "Bash",
      "match": "--path[=\\s]+[\\\\\\\"']*(?:\\./)?wt-12-trim-readme|git\\s+worktree\\s+add"
    }
  ],
  "max_calls": {
    "Bash": 4
  }
}
