+//SOURCES ../lib/SmEnv.java
+
+import com.hayden.testgraphsdk.sdk.NodeContext;
+import com.hayden.testgraphsdk.sdk.Procs;
+import com.hayden.testgraphsdk.sdk.ProcessRecord;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Shared fixture code for the {@code cheap-checks} graph (epic cheap-checks #414,
+ * built by CC-0 #441). NOT a node: nothing in {@code build.gradle.kts} names it;
+ * each node pulls it in with {@code //SOURCES CheapChecksKit.java}. Tickets fixing
+ * a clause edit that clause's node file only; nothing here should need to change.
+ *
+ * <p>Convention, so a red node says WHICH half is red:
+ * <ul>
+ *   <li>{@code setup_*}: the fixture exists. Red is a harness defect.</li>
+ *   <li>{@code control_*}: neighbouring behaviour that must hold before AND after
+ *       the fix, and proves the instrument can see what it counts.</li>
+ *   <li>{@code shape_*}: the clause's target. Expected red until its ticket lands.</li>
+ * </ul>
+ */
+final class CheapChecksKit {
+
+    private CheapChecksKit() {}
+
+    /** A fresh empty scratch root for one clause, with sandboxed agent homes. */
+    static Path scratch(NodeContext ctx, String clause) throws IOException {
+        String envHome = ctx.get("env.prepared", "home").orElse(null);
+        if (envHome == null) throw new IOException("missing env.prepared context");
+        Path root = Path.of(envHome).resolve("cheap-checks").resolve(clause).toAbsolutePath().normalize();
+        deleteTree(root);
+        Files.createDirectories(root.resolve("agents/claude"));
+        Files.createDirectories(root.resolve("agents/codex"));
+        Files.createDirectories(root.resolve("agents/gemini"));
+        return root;
+    }
+
+    /** The checkout's own project home: the fixture source for the timing clauses. */
+    static Path projectHome() {
+        return SmEnv.repoRoot().resolve(".skill-manager");
+    }
+
+    /** Write the permissive test policy, so unattended installs do not prompt. */
+    static void writePolicy(Path home) throws IOException {
+        Files.createDirectories(home);
+        Files.writeString(home.resolve("policy.toml"), """
+                require_confirmation = false
+                [install]
+                require_confirmation_for_hooks = false
+                require_confirmation_for_mcp = false
+                require_confirmation_for_cli_deps = false
+                require_confirmation_for_executable_commands = false
+                """);
+    }
+
+    private static ProcessBuilder builder(Path root, Path home, List<String> argv) {
+        ProcessBuilder pb = new ProcessBuilder(argv).directory(SmEnv.repoRoot().toFile());
+        Path agents = root.resolve("agents");
+        SmEnv.apply(pb, home.toString(), SmEnv.sandbox(
+                agents.resolve("claude"), agents.resolve("codex"), agents.resolve("gemini")));
+        return pb;
+    }
+
+    /** Run the checkout's CLI against {@code home}. */
+    static ProcessRecord sm(NodeContext ctx, String label, Path root, Path home, String... args) {
+        return sm(ctx, label, root, home, null, args);
+    }
+
+    /** {@link #sm} with {@code binDir} first on PATH: how fake agent CLIs are reached. */
+    static ProcessRecord sm(NodeContext ctx, String label, Path root, Path home, Path binDir, String... args) {
+        List<String> argv = new ArrayList<>();
+        argv.add(SmEnv.cli().toString());
+        argv.addAll(List.of(args));
+        ProcessBuilder pb = builder(root, home, argv);
+        if (binDir != null) pb.environment().merge("PATH", binDir + ":", (old, add) -> add + old);
+        return Procs.run(ctx, label, pb);
+    }
+
+    /** {@code home clone}: the worktree-provisioning path. {@code from} is read, never written. */
+    static ProcessRecord cloneHome(NodeContext ctx, String label, Path root, Path from, Path to) {
+        return sm(ctx, label, root, to, "home", "clone", "--from", from.toString(), "--to", to.toString());
+    }
+
+    static String output(NodeContext ctx, ProcessRecord record) {
+        if (record == null) return "";
+        try {
+            return Files.readString(Procs.logFile(ctx, record.label()));
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    // ------------------------------------------------------------------ timing
+
+    /** One {@code /usr/bin/time -l} reading. Seconds and max RSS are -1 when unparseable. */
+    record Timing(ProcessRecord process, double seconds, double rssMb, String output) {
+        boolean measured() { return seconds >= 0 && rssMb >= 0; }
+    }
+
+    private static final Pattern REAL = Pattern.compile("(\\d+(?:\\.\\d+)?)\\s+real\\b");
+    private static final Pattern RSS = Pattern.compile("(\\d+)\\s+maximum resident set size");
+
+    /**
+     * The CLI under BSD {@code /usr/bin/time -l} (macOS; GNU time has no such flag, so
+     * off macOS the reading is -1 and the node's setup assertion says so).
+     * {@code time} waits on the jbang launcher, which execs the application JVM in
+     * place, so the RSS is the JVM's; git subprocesses are far smaller.
+     */
+    static Timing timed(NodeContext ctx, String label, Path root, Path home, String... args) {
+        List<String> argv = new ArrayList<>(List.of("/usr/bin/time", "-l", SmEnv.cli().toString()));
+        argv.addAll(List.of(args));
+        ProcessRecord record = Procs.run(ctx, label, builder(root, home, argv));
+        String out = output(ctx, record);
+        Matcher real = REAL.matcher(out);
+        Matcher rss = RSS.matcher(out);
+        double seconds = -1;
+        while (real.find()) seconds = Double.parseDouble(real.group(1));
+        double mb = -1;
+        while (rss.find()) mb = Double.parseDouble(rss.group(1)) / (1024 * 1024);
+        return new Timing(record, seconds, mb, out);
+    }
+
+    static double median(double... values) {
+        double[] sorted = values.clone();
+        Arrays.sort(sorted);
+        return sorted[sorted.length / 2];
+    }
+
+    /** Write {@code json} to {@code <report>/evidence/<name>.json}; returns the path. */
+    static Path evidence(NodeContext ctx, String name, String json) throws IOException {
+        Path dir = ctx.reportDir().resolve("evidence");
+        Files.createDirectories(dir);
+        Path file = dir.resolve(name + ".json");
+        Files.writeString(file, json);
+        return file;
+    }
+
+    // ------------------------------------------------------------------ git
+
+    private record Result(int exit, String out) {}
+
+    private static Result run(Path dir, String... args) throws IOException, InterruptedException {
+        List<String> argv = new ArrayList<>();
+        argv.add("git");
+        argv.addAll(List.of(args));
+        Process p = new ProcessBuilder(argv).directory(dir.toFile()).redirectErrorStream(true).start();
+        String out = new String(p.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
+        return new Result(p.waitFor(), out);
+    }
+
+    static void git(Path dir, String... args) throws IOException, InterruptedException {
+        Result r = run(dir, args);
+        if (r.exit != 0) throw new IOException("git " + String.join(" ", args) + " (rc=" + r.exit + "): " + r.out);
+    }
+
+    static String gitOut(Path dir, String... args) throws IOException, InterruptedException {
+        Result r = run(dir, args);
+        if (r.exit != 0) throw new IOException("git " + String.join(" ", args) + " (rc=" + r.exit + "): " + r.out);
+        return r.out.trim();
+    }
+
+    /** git's exit code and output, never throwing: for the checklist that reports each op. */
+    static String[] gitTry(Path dir, String... args) {
+        try {
+            Result r = run(dir, args);
+            return new String[]{String.valueOf(r.exit), r.out.trim()};
+        } catch (Exception e) {
+            return new String[]{"-1", String.valueOf(e)};
+        }
+    }
+
+    static void commitAll(Path dir, String message) throws IOException, InterruptedException {
+        git(dir, "add", "-A");
+        git(dir, "-c", "user.email=cheap-checks@skillmanager.local", "-c", "user.name=cheap-checks",
+                "commit", "--quiet", "-m", message);
+    }
+
+    /** True when {@code dir} is a git checkout with no porcelain status. */
+    static boolean cleanCheckout(Path dir) {
+        String[] r = gitTry(dir, "status", "--porcelain");
+        return "0".equals(r[0]) && r[1].isEmpty();
+    }
+
+    // -------------------------------------------------------------- fixtures
+
+    static void writeSkill(Path dir, String name, String version, String marker) throws IOException {
+        Files.createDirectories(dir);
+        Files.writeString(dir.resolve("SKILL.md"), """
+                ---
+                name: %s
+                description: cheap-checks graph fixture.
+                ---
+
+                # %s
+
+                %s
+                """.formatted(name, name, marker));
+        Files.writeString(dir.resolve("skill-manager.toml"), """
+                [skill]
+                name = "%s"
+                version = "%s"
+                description = "cheap-checks graph fixture"
+                """.formatted(name, version));
+    }
+
+    /** A plugin unit with one contained skill. */
+    static void writePlugin(Path dir, String name, String marker) throws IOException {
+        Files.createDirectories(dir.resolve(".claude-plugin"));
+        Files.writeString(dir.resolve(".claude-plugin/plugin.json"),
+                "{\"name\":\"" + name + "\",\"version\":\"0.0.1\",\"description\":\"cheap-checks fixture.\"}\n");
+        Files.writeString(dir.resolve("skill-manager-plugin.toml"), """
+                [plugin]
+                name = "%s"
+                version = "0.0.1"
+                description = "cheap-checks fixture."
+                """.formatted(name));
+        Path contained = dir.resolve("skills").resolve(name + "-impl");
+        Files.createDirectories(contained);
+        Files.writeString(contained.resolve("SKILL.md"),
+                "---\nname: " + name + "-impl\ndescription: Contained fixture skill.\n---\n\n" + marker + "\n");
+        Files.writeString(contained.resolve("skill-manager.toml"), """
+                [skill]
+                name = "%s-impl"
+                version = "0.0.1"
+                description = "Contained fixture skill."
+                """.formatted(name));
+    }
+
+    static void writeExecutable(Path file, String body) throws IOException {
+        Files.createDirectories(file.getParent());
+        Files.writeString(file, body);
+        file.toFile().setExecutable(true);
+    }
+
+    static String read(Path file) {
+        try {
+            return Files.isRegularFile(file) ? Files.readString(file) : "";
+        } catch (IOException e) {
+            return "";
+        }
+    }
+
+    /** Non-empty lines of {@code file}; empty when it does not exist. */
+    static List<String> lines(Path file) {
+        return read(file).lines().filter(l -> !l.isBlank()).toList();
+    }
+
+    static long fileCount(Path dir) throws IOException {
+        if (!Files.exists(dir)) return 0;
+        try (var s = Files.walk(dir)) {
+            return s.filter(Files::isRegularFile).count();
+        }
+    }
+
+    static void deleteTree(Path root) throws IOException {
+        if (!Files.exists(root, java.nio.file.LinkOption.NOFOLLOW_LINKS)) return;
+        try (var s = Files.walk(root)) {
+            for (Path p : s.sorted(Comparator.reverseOrder()).toList()) Files.deleteIfExists(p);
+        }
+    }
+
+    /** {@code claude} remembers added marketplaces so its re-list confirms them; {@code codex} just logs. */
+    static void writeFakeAgents(Path bin, Path log, Path state) throws Exception {
+        String head = "#!/usr/bin/env bash\necho \"$(basename \"$0\") $*\" >> \"" + log + "\"\n";
+        writeExecutable(bin.resolve("codex"), head + "exit 0\n");
+        writeExecutable(bin.resolve("claude"), head + """
+                if [ "$1 $2 $3" = "plugin marketplace add" ]; then
+                  printf '%s\\n' "$4" >> "@STATE@"; exit 0
+                fi
+                if [ "$1 $2 $3" = "plugin marketplace list" ]; then
+                  printf '['; sep=''
+                  if [ -f "@STATE@" ]; then
+                    while IFS= read -r p; do
+                      n=$(sed -n 's/.*"name" *: *"\\([^"]*\\)".*/\\1/p' "$p/.claude-plugin/marketplace.json" | head -1)
+                      printf '%s{"name":"%s","path":"%s"}' "$sep" "$n" "$p"; sep=','
+                    done < "@STATE@"
+                  fi
+                  printf ']\\n'; exit 0
+                fi
+                if [ "$1 $2" = "plugin list" ]; then printf '[]\\n'; exit 0; fi
+                exit 0
+                """.replace("@STATE@", state.toString()));
+    }
+
+    /** Assertion-name-safe list of names. */
+    static Set<String> setOf(String... names) {
+        return Set.of(names);
+    }
+}
diff --git a/test_graph/sources/cheap-checks/CloseOutTime.java b/test_graph/sources/cheap-checks/CloseOutTime.java
new file mode 100644
index 00000000..faa5d1b3
--- /dev/null
+++ b/test_graph/sources/cheap-checks/CloseOutTime.java
@@ -0,0 +1,157 @@
+///usr/bin/env jbang "$0" "$@" ; exit $?
+//SOURCES ../../sdk/java/src/main/java/com/hayden/testgraphsdk/sdk/*.java
+//SOURCES ../lib/SmEnv.java
+//SOURCES CheapChecksKit.java
+
+import com.hayden.testgraphsdk.sdk.Node;
+import com.hayden.testgraphsdk.sdk.NodeResult;
+import com.hayden.testgraphsdk.sdk.NodeSpec;
+import com.hayden.testgraphsdk.sdk.ProcessRecord;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/**
+ * GOAL-checking-costs-what-changed clause (b), #401: {@code home close-out} under 5 s
+ * and under 300 MB RSS on a home holding {@code tla-spec-dev}.
+ *
+ * <p>Fixture: two {@code home clone}s of this checkout's project home. Closing one into
+ * the other is the worktree-to-project shape. This is NOT #401's fixture (another
+ * repository's 31,756-file, 428 MB home); the plugin here is this repository's own
+ * copy, and the file count is in the evidence.
+ *
+ * <p>CONTROL: an unpublished edit to the plugin still blocks by name (exit non-zero),
+ * so a speedup that stops looking turns this red.
+ *
+ * <p>CONTROL: an edit to a small unit in the same large home blocks by name, and is
+ * caught at about the speed of a clean close-out: a fast path that made the clean
+ * case fast by making the dirty case skip the home would pass a clock on the first.
+ */
+public class CloseOutTime {
+    static final String ID = "cheap.close-out";
+    static final double TARGET_SECONDS = 5.0;
+    static final double TARGET_RSS_MB = 300.0;
+    static final NodeSpec SPEC = NodeSpec.of(ID)
+            .kind(NodeSpec.Kind.ASSERTION)
+            .dependsOn("env.prepared")
+            .tags("cheap-checks", "close-out", "401", "timing")
+            .timeout("900s");
+
+    public static void main(String[] args) {
+        Node.run(args, SPEC, ctx -> {
+            Path root;
+            Path a;
+            Path b;
+            ProcessRecord cloneA;
+            ProcessRecord cloneB;
+            try {
+                root = CheapChecksKit.scratch(ctx, "close-out");
+                a = root.resolve("worktree-home");
+                b = root.resolve("project-home");
+                cloneA = CheapChecksKit.cloneHome(ctx, "clone_a", root, CheapChecksKit.projectHome(), a);
+                cloneB = CheapChecksKit.cloneHome(ctx, "clone_b", root, CheapChecksKit.projectHome(), b);
+            } catch (Exception e) {
+                return NodeResult.fail(ID, "setup failed: " + e).assertion("setup_ok", false);
+            }
+            Path plugin = a.resolve("plugins/tla-spec-dev");
+            boolean setupCloned = cloneA.exitCode() == 0 && cloneB.exitCode() == 0 && Files.isDirectory(plugin);
+            long pluginFiles;
+            try {
+                pluginFiles = CheapChecksKit.fileCount(plugin);
+            } catch (Exception e) {
+                pluginFiles = -1;
+            }
+            CheapChecksKit.sm(ctx, "warmup", root, a, "home", "close-out", "--home", a.toString(), "--into", b.toString());
+
+            double[] seconds = new double[3];
+            double[] rss = new double[3];
+            boolean measured = true;
+            int exit = -1;
+            String out = "";
+            for (int i = 0; i < 3; i++) {
+                CheapChecksKit.Timing t = CheapChecksKit.timed(ctx, "closeout_" + i, root, a,
+                        "home", "close-out", "--home", a.toString(), "--into", b.toString(), "--json");
+                seconds[i] = t.seconds();
+                rss[i] = t.rssMb();
+                measured &= t.measured();
+                exit = t.process().exitCode();
+                out = t.output();
+            }
+            double median = CheapChecksKit.median(seconds);
+            double medianRss = CheapChecksKit.median(rss);
+            boolean controlCleanSafe = exit == 0 && out.contains("\"safe\"") && !out.contains("\"safe\" : false")
+                    && !out.contains("\"safe\":false");
+
+            boolean controlEditBlocks = false;
+            boolean controlSmallEditBlocks = false;
+            double smallEditSeconds = -1;
+            double editedPluginSeconds = -1;
+            ProcessRecord blocked = null;
+            ProcessRecord blockedSmall = null;
+            try {
+                // First, while the plugin is clean: the other units stay on the
+                // fast path, so this reading is the cost of finding one real edit.
+                Path smallUnit = a.resolve("skills/tracing-observability/SKILL.md");
+                String original = Files.readString(smallUnit);
+                Files.writeString(smallUnit, original + "\ncheap-checks unpublished edit\n");
+                CheapChecksKit.Timing small = CheapChecksKit.timed(ctx, "closeout_small_edit", root, a,
+                        "home", "close-out", "--home", a.toString(), "--into", b.toString(), "--json");
+                Files.writeString(smallUnit, original);
+                blockedSmall = small.process();
+                smallEditSeconds = small.seconds();
+                controlSmallEditBlocks = blockedSmall.exitCode() != 0
+                        && small.output().contains("tracing-observability");
+
+                Path readme = plugin.resolve("README.md");
+                Files.writeString(readme, Files.readString(readme) + "\ncheap-checks unpublished edit\n");
+                CheapChecksKit.Timing edited = CheapChecksKit.timed(ctx, "closeout_edited", root, a,
+                        "home", "close-out", "--home", a.toString(), "--into", b.toString(), "--json");
+                blocked = edited.process();
+                editedPluginSeconds = edited.seconds();
+                controlEditBlocks = blocked.exitCode() != 0
+                        && edited.output().contains("tla-spec-dev");
+            } catch (Exception e) {
+                return NodeResult.fail(ID, "setup failed planting the edit: " + e).assertion("setup_ok", false);
+            }
+
+            // Against the clean close-out just measured, not the absolute target: this
+            // reads one small unit's bytes more than the clean run, so it should
+            // cost about what the clean run costs.
+            boolean smallEditFast = smallEditSeconds >= 0 && smallEditSeconds <= median * 1.5 + 1.0;
+            boolean timeOk = median < TARGET_SECONDS;
+            boolean rssOk = medianRss < TARGET_RSS_MB;
+            String json = "{\"fixture\":\"two home clones of the project home holding tla-spec-dev\","
+                    + "\"plugin_files\":" + pluginFiles + ",\"seconds\":" + java.util.Arrays.toString(seconds)
+                    + ",\"median_seconds\":" + median + ",\"rss_mb\":" + java.util.Arrays.toString(rss)
+                    + ",\"median_rss_mb\":" + medianRss + ",\"target_seconds\":" + TARGET_SECONDS
+                    + ",\"target_rss_mb\":" + TARGET_RSS_MB + ",\"clean_exit\":" + exit
+                    + ",\"small_unit_edit_seconds\":" + smallEditSeconds
+                    + ",\"plugin_edit_seconds\":" + editedPluginSeconds + "}";
+            String detail;
+            try {
+                detail = "evidence=" + CheapChecksKit.evidence(ctx, "close-out", json) + " " + json;
+            } catch (Exception e) {
+                detail = json;
+            }
+            boolean setup = setupCloned && measured;
+            NodeResult result = setup && controlCleanSafe && controlEditBlocks && controlSmallEditBlocks
+                    && smallEditFast && timeOk && rssOk
+                    ? NodeResult.pass(ID) : NodeResult.fail(ID, detail);
+            return result.process(cloneA).process(cloneB).process(blocked).process(blockedSmall)
+                    .metric("median_seconds", median)
+                    .metric("median_rss_mb", medianRss)
+                    .metric("plugin_files", pluginFiles)
+                    .metric("small_unit_edit_seconds", smallEditSeconds)
+                    .metric("plugin_edit_seconds", editedPluginSeconds)
+                    .assertion("setup_two_clones_hold_plugin", setupCloned)
+                    .assertion("setup_time_l_parsed", measured)
+                    .assertion("control_clean_home_closes_safe", controlCleanSafe)
+                    .assertion("control_unpublished_edit_blocks_by_name", controlEditBlocks)
+                    .assertion("control_small_unit_edit_blocks_by_name", controlSmallEditBlocks)
+                    .assertion("shape_small_unit_edit_caught_at_clean_closeout_speed", smallEditFast)
+                    .assertion("shape_close_out_under_5s", timeOk)
+                    .assertion("shape_close_out_under_300mb_rss", rssOk)
+                    .log(detail);
+        });
+    }
+}
diff --git a/test_graph/sources/cheap-checks/EditDetection.java b/test_graph/sources/cheap-checks/EditDetection.java
new file mode 100644
index 00000000..8259c2e0
--- /dev/null
+++ b/test_graph/sources/cheap-checks/EditDetection.java
@@ -0,0 +1,142 @@
+///usr/bin/env jbang "$0" "$@" ; exit $?
+//SOURCES ../../sdk/java/src/main/java/com/hayden/testgraphsdk/sdk/*.java
+//SOURCES ../lib/SmEnv.java
+//SOURCES CheapChecksKit.java
+
+import com.hayden.testgraphsdk.sdk.Node;
+import com.hayden.testgraphsdk.sdk.NodeContext;
+import com.hayden.testgraphsdk.sdk.NodeResult;
+import com.hayden.testgraphsdk.sdk.NodeSpec;
+import com.hayden.testgraphsdk.sdk.ProcessRecord;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/**
+ * GOAL-checking-costs-what-changed clause (a), the detection half: every planted edit
+ * under a marketplace plugin still marks its {@code marketplace-entry:} row stale, so a
+ * faster check cannot be a blinder one. Tracked, untracked and link must stay detected.
+ *
+ * <p><b>A gitignored file is NOT part of a unit's identity.</b> AWAITING OWNER
+ * CONFIRMATION (#410). The arm asserts it does not move the row. That is also what
+ * happened at the CC-0 baseline, whose stated cause was wrong: not
+ * {@code HomeDigest.withoutIgnored}, which this code path never calls, but
+ * {@code ChildHomeMaterializer.plainView}, which walks with
+ * {@code GitIgnoreRules.forUnit(root)}. The control still proves the arm ran.
+ *
+ * <p>Plants, one at a time, restoring between them: a tracked edit, an untracked file,
+ * a gitignored file (which must NOT be detected) and
+ * a re-pointed marketplace link (to a byte-identical copy, so only the link target
+ * differs). Each plant has a CONTROL: after restoring, the row is clean again, which
+ * proves the detection was the plant and not a sticky row.
+ */
+public class EditDetection {
+    static final String ID = "cheap.edit-detection";
+    static final String PLUGIN = "cc-edit-plugin";
+    static final NodeSpec SPEC = NodeSpec.of(ID)
+            .kind(NodeSpec.Kind.ASSERTION)
+            .dependsOn("env.prepared")
+            .tags("cheap-checks", "artifacts-stale", "410", "edit-detection")
+            .timeout("600s");
+
+    interface Plant { void apply() throws Exception; }
+
+    public static void main(String[] args) {
+        Node.run(args, SPEC, ctx -> {
+            Path root;
+            Path home;
+            ProcessRecord install;
+            Path copy;
+            try {
+                root = CheapChecksKit.scratch(ctx, "edit-detection");
+                home = root.resolve("home");
+                CheapChecksKit.writePolicy(home);
+                Path upstream = root.resolve("upstream");
+                CheapChecksKit.writePlugin(upstream, PLUGIN, "marker");
+                Files.writeString(upstream.resolve(".gitignore"), "ignored.txt\n");
+                CheapChecksKit.git(upstream, "init", "-b", "main", "--quiet");
+                CheapChecksKit.commitAll(upstream, "A");
+                // Agent projection is what writes the marketplace link, so this install binds
+                // (no --no-bind-default) through fake agent CLIs; real ones are never run.
+                Path bin = root.resolve("fake-bin");
+                CheapChecksKit.writeFakeAgents(bin, root.resolve("agent-cli.log"), root.resolve("claude-marketplaces"));
+                install = CheapChecksKit.sm(ctx, "install", root, home, bin,
+                        "install", "git+" + upstream.toUri(), "--yes");
+                copy = root.resolve("identical-copy");
+                CheapChecksKit.git(root, "clone", "--quiet", upstream.toString(), copy.toString());
+            } catch (Exception e) {
+                return NodeResult.fail(ID, "setup failed: " + e).assertion("setup_ok", false);
+            }
+            Path plugin = home.resolve("plugins").resolve(PLUGIN);
+            Path link = home.resolve("plugin-marketplace/plugins").resolve(PLUGIN);
+            boolean setupInstalled = install.exitCode() == 0 && Files.isDirectory(plugin)
+                    && Files.isSymbolicLink(link);
+            boolean setupClean = !staleRow(ctx, "before", root, home);
+            final Path pluginF = plugin;
+            final Path linkF = link;
+            final Path copyF = copy;
+            Path original;
+            try {
+                original = Files.readSymbolicLink(link);
+            } catch (Exception e) {
+                return NodeResult.fail(ID, "no marketplace link to re-point: " + e)
+                        .process(install).assertion("setup_installed_with_marketplace_link", false);
+            }
+
+            Arm tracked = arm(ctx, "tracked", root, home,
+                    () -> Files.writeString(pluginF.resolve(".claude-plugin/plugin.json"),
+                            Files.readString(pluginF.resolve(".claude-plugin/plugin.json")) + " "),
+                    () -> CheapChecksKit.git(pluginF, "checkout", "--", "."));
+            Arm untracked = arm(ctx, "untracked", root, home,
+                    () -> Files.writeString(pluginF.resolve("untracked.txt"), "x"),
+                    () -> Files.delete(pluginF.resolve("untracked.txt")));
+            Arm gitignored = arm(ctx, "gitignored", root, home,
+                    () -> Files.writeString(pluginF.resolve("ignored.txt"), "x"),
+                    () -> Files.delete(pluginF.resolve("ignored.txt")));
+            Arm relinked = arm(ctx, "repointed_link", root, home,
+                    () -> { Files.delete(linkF); Files.createSymbolicLink(linkF, copyF); },
+                    () -> { Files.delete(linkF); Files.createSymbolicLink(linkF, original); });
+
+            boolean setup = setupInstalled && setupClean;
+            boolean controls = tracked.restored && untracked.restored && gitignored.restored && relinked.restored;
+            boolean shape = tracked.detected && untracked.detected && !gitignored.detected && relinked.detected;
+            String detail = "tracked=" + tracked + " untracked=" + untracked + " gitignored=" + gitignored
+                    + " repointed_link=" + relinked + " setupInstalled=" + setupInstalled + " setupClean=" + setupClean;
+            NodeResult result = setup && controls && shape ? NodeResult.pass(ID) : NodeResult.fail(ID, detail);
+            return result.process(install)
+                    .metric("planted_edits_detected", (tracked.detected ? 1 : 0) + (untracked.detected ? 1 : 0)
+                            + (relinked.detected ? 1 : 0))
+                    .metric("gitignored_file_detected", gitignored.detected ? 1 : 0)
+                    .assertion("setup_installed_with_marketplace_link", setupInstalled)
+                    .assertion("setup_clean_checkout_row_is_not_stale", setupClean)
+                    .assertion("control_row_clean_after_restoring_tracked_edit", tracked.restored)
+                    .assertion("control_row_clean_after_removing_untracked_file", untracked.restored)
+                    .assertion("control_row_clean_after_removing_gitignored_file", gitignored.restored)
+                    .assertion("control_row_clean_after_restoring_link", relinked.restored)
+                    .assertion("shape_tracked_edit_detected", tracked.detected)
+                    .assertion("shape_untracked_file_detected", untracked.detected)
+                    .assertion("shape_gitignored_file_not_detected", !gitignored.detected)
+                    .assertion("shape_repointed_link_detected", relinked.detected)
+                    .log(detail);
+        });
+    }
+
+    record Arm(boolean detected, boolean restored) {}
+
+    static Arm arm(NodeContext ctx, String name, Path root, Path home, Plant plant, Plant restore) {
+        try {
+            plant.apply();
+            boolean detected = staleRow(ctx, name + "_planted", root, home);
+            restore.apply();
+            boolean clean = !staleRow(ctx, name + "_restored", root, home);
+            return new Arm(detected, clean);
+        } catch (Exception e) {
+            return new Arm(false, false);
+        }
+    }
+
+    static boolean staleRow(NodeContext ctx, String label, Path root, Path home) {
+        ProcessRecord r = CheapChecksKit.sm(ctx, label, root, home, "artifacts", "stale", "--json");
+        return CheapChecksKit.output(ctx, r).contains("marketplace-entry:" + PLUGIN);
+    }
+}
diff --git a/test_graph/sources/cheap-checks/ForeignInstallers.java b/test_graph/sources/cheap-checks/ForeignInstallers.java
new file mode 100644
index 00000000..57a7427f
--- /dev/null
+++ b/test_graph/sources/cheap-checks/ForeignInstallers.java
@@ -0,0 +1,169 @@
+///usr/bin/env jbang "$0" "$@" ; exit $?
+//SOURCES ../../sdk/java/src/main/java/com/hayden/testgraphsdk/sdk/*.java
+//SOURCES ../lib/SmEnv.java
+//SOURCES CheapChecksKit.java
+
+import com.hayden.testgraphsdk.sdk.Node;
+import com.hayden.testgraphsdk.sdk.NodeResult;
+import com.hayden.testgraphsdk.sdk.NodeSpec;
+import com.hayden.testgraphsdk.sdk.ProcessRecord;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+/**
+ * GOAL-checking-costs-what-changed clause (c), #402: {@code sync <unit>} in a home made
+ * by {@code home clone} re-runs 0 OTHER units' skill-script installers.
+ *
+ * <p>Fixture: three units with a skill-script CLI dep whose installer writes a cache
+ * tree plus a wrapper exec'ing into it (the deploy-helm shape, so {@code cache/} being
+ * skipped by the clone leaves the wrapper unusable) and appends the unit name to a
+ * counter file outside the home. Synthetic rather than deploy-helm: a run must count
+ * invocations exactly and not depend on network builds.
+ *
+ * <p>The asserted arm is {@code sync <unit> --from <dir> --yes --skip-mcp}. A second,
+ * {@code --force-scripts}, arm is measured only: that flag explicitly asks for a replay,
+ * #402's reproduction uses it, and CC-2 must not change its semantics, so what it
+ * re-runs is reported (metric) and not targeted.
+ *
+ * <p>CONTROLS: the source install ran each installer exactly once (the counter counts),
+ * the synced unit's new bytes landed in the clone (the sync really ran), and editing the
+ * target's script re-runs it (a stale installer is not skipped). The plain sync must also
+ * name each other unit's tool it left unbuilt: a skip the home is silent about would
+ * pass the count and leave an unreported broken binary.
+ */
+public class ForeignInstallers {
+    static final String ID = "cheap.foreign-installers";
+    static final List<String> FOREIGN = List.of("cc-foreign-a", "cc-foreign-b");
+    static final String TARGET = "cc-target";
+    static final NodeSpec SPEC = NodeSpec.of(ID)
+            .kind(NodeSpec.Kind.ASSERTION)
+            .dependsOn("env.prepared")
+            .tags("cheap-checks", "sync", "402", "installers")
+            .timeout("600s");
+
+    public static void main(String[] args) {
+        Node.run(args, SPEC, ctx -> {
+            Path root;
+            Path source;
+            Path clone;
+            Path cloneForce;
+            Path counter;
+            Path targetDir;
+            ProcessRecord cloned;
+            ProcessRecord clonedForce;
+            boolean installs = true;
+            try {
+                root = CheapChecksKit.scratch(ctx, "foreign-installers");
+                source = root.resolve("source");
+                clone = root.resolve("clone");
+                cloneForce = root.resolve("clone-force");
+                counter = root.resolve("installer-runs.log");
+                CheapChecksKit.writePolicy(source);
+                for (String unit : FOREIGN) {
+                    Path d = scaffold(root.resolve("units"), unit, counter, "v1");
+                    installs &= CheapChecksKit.sm(ctx, "install_" + unit, root, source,
+                            "install", d.toString(), "--yes", "--no-bind-default").exitCode() == 0;
+                }
+                targetDir = scaffold(root.resolve("units"), TARGET, counter, "v1");
+                installs &= CheapChecksKit.sm(ctx, "install_" + TARGET, root, source,
+                        "install", targetDir.toString(), "--yes", "--no-bind-default").exitCode() == 0;
+                cloned = CheapChecksKit.cloneHome(ctx, "clone", root, source, clone);
+                clonedForce = CheapChecksKit.cloneHome(ctx, "clone_force", root, source, cloneForce);
+            } catch (Exception e) {
+                return NodeResult.fail(ID, "setup failed: " + e).assertion("setup_ok", false);
+            }
+            List<String> atInstall = CheapChecksKit.lines(counter);
+            boolean controlCounterCounts = atInstall.size() == 3 && atInstall.containsAll(FOREIGN) && atInstall.contains(TARGET);
+
+            long foreignPlain;
+            long foreignForce;
+            long targetRerunAfterEdit;
+            boolean unbuiltNamed;
+            ProcessRecord sync;
+            ProcessRecord syncForce;
+            try {
+                Files.writeString(targetDir.resolve("SKILL.md"),
+                        Files.readString(targetDir.resolve("SKILL.md")) + "\nsynced-marker\n");
+                Files.deleteIfExists(counter);
+                sync = CheapChecksKit.sm(ctx, "sync", root, clone,
+                        "sync", TARGET, "--from", targetDir.toString(), "--yes", "--skip-mcp");
+                foreignPlain = foreignRuns(counter);
+                String syncOutput = CheapChecksKit.output(ctx, sync);
+                unbuiltNamed = FOREIGN.stream().allMatch(u -> syncOutput.contains(u + "-tool (" + u + ")"));
+                Files.deleteIfExists(counter);
+                Path script = targetDir.resolve("skill-scripts/install-tool.sh");
+                Files.writeString(script, Files.readString(script) + "\n# edited\n");
+                CheapChecksKit.sm(ctx, "sync_edited", root, clone,
+                        "sync", TARGET, "--from", targetDir.toString(), "--yes", "--skip-mcp");
+                targetRerunAfterEdit = CheapChecksKit.lines(counter).stream().filter(TARGET::equals).count();
+                Files.deleteIfExists(counter);
+                syncForce = CheapChecksKit.sm(ctx, "sync_force", root, cloneForce,
+                        "sync", TARGET, "--from", targetDir.toString(), "--yes", "--skip-mcp", "--force-scripts");
+                foreignForce = foreignRuns(counter);
+            } catch (Exception e) {
+                return NodeResult.fail(ID, "setup failed during sync: " + e).assertion("setup_ok", false);
+            }
+            boolean controlSyncLanded = sync.exitCode() == 0 && CheapChecksKit
+                    .read(clone.resolve("skills").resolve(TARGET).resolve("SKILL.md")).contains("synced-marker");
+            boolean setup = installs && cloned.exitCode() == 0 && clonedForce.exitCode() == 0;
+            boolean shape = foreignPlain == 0;
+            String detail = "foreign installers re-run: plain=" + foreignPlain + " force_scripts=" + foreignForce
+                    + " (of " + FOREIGN.size() + "); sync rc=" + sync.exitCode() + " force rc=" + syncForce.exitCode()
+                    + "; counter at install=" + atInstall
+                    + "; target reruns after script edit=" + targetRerunAfterEdit + "; unbuilt named=" + unbuiltNamed;
+            boolean controlEditedReruns = targetRerunAfterEdit == 1;
+            NodeResult result = setup && controlCounterCounts && controlSyncLanded && shape
+                    && unbuiltNamed && controlEditedReruns
+                    ? NodeResult.pass(ID) : NodeResult.fail(ID, detail);
+            return result.process(sync).process(syncForce)
+                    .metric("foreign_installers_rerun", foreignPlain)
+                    .metric("foreign_installers_rerun_force_scripts", foreignForce)
+                    .metric("foreign_units", FOREIGN.size())
+                    .assertion("setup_units_installed_and_cloned", setup)
+                    .assertion("control_counter_counts_each_installer_once", controlCounterCounts)
+                    .assertion("control_sync_landed_on_named_unit", controlSyncLanded)
+                    .assertion("shape_no_other_units_installers_rerun", shape)
+                    .assertion("control_edited_script_reruns", controlEditedReruns)
+                    .assertion("shape_unbuilt_other_unit_tools_are_named", unbuiltNamed)
+                    .log(detail);
+        });
+    }
+
+    static long foreignRuns(Path counter) {
+        return CheapChecksKit.lines(counter).stream().filter(FOREIGN::contains).count();
+    }
+
+    static Path scaffold(Path parent, String unit, Path counter, String marker) throws Exception {
+        Path dir = parent.resolve(unit);
+        String tool = unit + "-tool";
+        CheapChecksKit.writeSkill(dir, unit, "0.1.0", marker);
+        Files.writeString(dir.resolve("skill-manager.toml"), """
+                [skill]
+                name = "%s"
+                version = "0.1.0"
+                description = "cheap-checks graph fixture"
+
+                [[cli_dependencies]]
+                spec = "skill-script:%s"
+                on_path = "%s"
+
+                [cli_dependencies.install.any]
+                script = "install-tool.sh"
+                binary = "%s"
+                """.formatted(unit, tool, tool, tool));
+        CheapChecksKit.writeExecutable(dir.resolve("skill-scripts/install-tool.sh"), """
+                #!/usr/bin/env bash
+                set -euo pipefail
+                echo "@UNIT@" >> "@COUNTER@"
+                tree="$SKILL_MANAGER_HOME/cache/cc-@UNIT@"
+                mkdir -p "$tree/bin" "$SKILL_MANAGER_HOME/bin/cli"
+                printf '#!/usr/bin/env bash\\necho ok\\n' > "$tree/bin/@TOOL@"
+                chmod +x "$tree/bin/@TOOL@"
+                printf '#!/usr/bin/env bash\\nexec "%s/bin/@TOOL@" "$@"\\n' "$tree" > "$SKILL_MANAGER_HOME/bin/cli/@TOOL@"
+                chmod +x "$SKILL_MANAGER_HOME/bin/cli/@TOOL@"
+                """.replace("@UNIT@", unit).replace("@COUNTER@", counter.toString()).replace("@TOOL@", tool));
+        return dir;
+    }
+}
diff --git a/test_graph/sources/cheap-checks/ForeignProjection.java b/test_graph/sources/cheap-checks/ForeignProjection.java
new file mode 100644
index 00000000..aa8cfa6d
--- /dev/null
+++ b/test_graph/sources/cheap-checks/ForeignProjection.java
@@ -0,0 +1,129 @@
+///usr/bin/env jbang "$0" "$@" ; exit $?
+//SOURCES ../../sdk/java/src/main/java/com/hayden/testgraphsdk/sdk/*.java
+//SOURCES ../lib/SmEnv.java
+//SOURCES CheapChecksKit.java
+
+import com.hayden.testgraphsdk.sdk.Node;
+import com.hayden.testgraphsdk.sdk.NodeResult;
+import com.hayden.testgraphsdk.sdk.NodeSpec;
+import com.hayden.testgraphsdk.sdk.ProcessRecord;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+/**
+ * GOAL-checking-costs-what-changed clause (d), #402 first comment / #442: {@code sync
+ * <unit>} re-projects 0 OTHER plugins into the agents.
+ *
+ * <p>Fixture: two plugins, with fake {@code claude} and {@code codex} first on PATH.
+ * The fakes append their argv to a log and answer the marketplace list so the driver
+ * reaches {@code install}. An argv naming the other plugin is one projection, whatever
+ * its CLI cost would be; the number is per agent per verb and is the honest unit of
+ * work #402 is about. Real agent CLIs are not run: the graph must not touch real
+ * agent state and must not depend on their being installed.
+ *
+ * <p>CONTROLS: install projected both plugins through the fakes (the log sees them);
+ * the sync installed the NAMED plugin into BOTH agents; {@code sync} with no unit still
+ * projects both; the marketplace file still lists both; and, because the fakes record
+ * no enablement, the other plugin is NAMED as absent rather than passed over in silence.
+ */
+public class ForeignProjection {
+    static final String ID = "cheap.foreign-projection";
+    static final String TARGET = "cc-proj-target";
+    static final String OTHER = "cc-proj-other";
+    static final NodeSpec SPEC = NodeSpec.of(ID)
+            .kind(NodeSpec.Kind.ASSERTION)
+            .dependsOn("env.prepared")
+            .tags("cheap-checks", "sync", "402", "442", "projection")
+            .timeout("600s");
+
+    public static void main(String[] args) {
+        Node.run(args, SPEC, ctx -> {
+            Path root;
+            Path source;
+            Path clone;
+            Path log;
+            Path bin;
+            Path targetDir;
+            ProcessRecord installTarget;
+            ProcessRecord installOther;
+            ProcessRecord cloned;
+            ProcessRecord sync;
+            ProcessRecord syncAll;
+            List<String> atInstall;
+            List<String> atSync;
+            List<String> atSyncAll;
+            try {
+                root = CheapChecksKit.scratch(ctx, "foreign-projection");
+                source = root.resolve("source");
+                clone = root.resolve("clone");
+                log = root.resolve("agent-cli.log");
+                bin = root.resolve("fake-bin");
+                CheapChecksKit.writePolicy(source);
+                CheapChecksKit.writeFakeAgents(bin, log, root.resolve("claude-marketplaces"));
+                targetDir = root.resolve("units").resolve(TARGET);
+                Path otherDir = root.resolve("units").resolve(OTHER);
+                CheapChecksKit.writePlugin(targetDir, TARGET, "v1");
+                CheapChecksKit.writePlugin(otherDir, OTHER, "v1");
+                installTarget = CheapChecksKit.sm(ctx, "install_target", root, source, bin,
+                        "install", targetDir.toString(), "--yes");
+                installOther = CheapChecksKit.sm(ctx, "install_other", root, source, bin,
+                        "install", otherDir.toString(), "--yes");
+                atInstall = CheapChecksKit.lines(log);
+                cloned = CheapChecksKit.cloneHome(ctx, "clone", root, source, clone);
+                Files.writeString(targetDir.resolve("skills").resolve(TARGET + "-impl").resolve("SKILL.md"),
+                        Files.readString(targetDir.resolve("skills").resolve(TARGET + "-impl").resolve("SKILL.md"))
+                                + "\nsynced-marker\n");
+                Files.deleteIfExists(log);
+                sync = CheapChecksKit.sm(ctx, "sync_one", root, clone, bin,
+                        "sync", TARGET, "--from", targetDir.toString(), "--yes", "--skip-mcp");
+                atSync = CheapChecksKit.lines(log);
+                Files.deleteIfExists(log);
+                syncAll = CheapChecksKit.sm(ctx, "sync_all", root, clone, bin, "sync", "--yes", "--skip-mcp");
+                atSyncAll = CheapChecksKit.lines(log);
+            } catch (Exception e) {
+                return NodeResult.fail(ID, "setup failed: " + e).assertion("setup_ok", false);
+            }
+            boolean setup = installTarget.exitCode() == 0 && installOther.exitCode() == 0 && cloned.exitCode() == 0;
+            boolean controlInstallProjected = names(atInstall, TARGET) > 0 && names(atInstall, OTHER) > 0;
+            boolean controlSyncLanded = sync.exitCode() == 0 && names(atSync, TARGET) > 0
+                    && CheapChecksKit.read(clone.resolve("plugins").resolve(TARGET)
+                            .resolve("skills").resolve(TARGET + "-impl").resolve("SKILL.md")).contains("synced-marker");
+            boolean controlNamedInstalledInBothAgents = atSync.stream().anyMatch(
+                            l -> l.startsWith("claude plugin install " + TARGET + "@"))
+                    && atSync.stream().anyMatch(l -> l.startsWith("codex plugin add " + TARGET + "@"));
+            String syncOut = CheapChecksKit.output(ctx, sync);
+            boolean controlAbsentOtherIsNamed = syncOut.contains("this sync did not install them")
+                    && syncOut.contains(OTHER + " (claude)") && syncOut.contains(OTHER + " (codex)");
+            boolean controlSyncAll = syncAll.exitCode() == 0 && names(atSyncAll, TARGET) > 0 && names(atSyncAll, OTHER) > 0;
+            String market = CheapChecksKit.read(clone.resolve("plugin-marketplace/.claude-plugin/marketplace.json"));
+            boolean controlMarketplaceListsBoth = market.contains(TARGET) && market.contains(OTHER);
+            long otherProjections = names(atSync, OTHER);
+            boolean shape = otherProjections == 0;
+            String detail = "calls naming " + OTHER + " during sync of " + TARGET + "=" + otherProjections
+                    + " agent-cli lines=" + atSync.size() + " sync rc=" + sync.exitCode()
+                    + " syncAll rc=" + syncAll.exitCode() + " target calls=" + names(atSync, TARGET)
+                    + " at install=" + atInstall.size() + " at syncAll=" + atSyncAll.size();
+            NodeResult result = setup && controlInstallProjected && controlSyncLanded && controlNamedInstalledInBothAgents
+                    && controlAbsentOtherIsNamed && controlSyncAll
+                    && controlMarketplaceListsBoth && shape ? NodeResult.pass(ID) : NodeResult.fail(ID, detail);
+            return result.process(installTarget).process(installOther).process(sync).process(syncAll)
+                    .metric("other_plugin_projection_calls", otherProjections)
+                    .metric("agent_cli_calls_during_sync", atSync.size())
+                    .assertion("setup_two_plugins_installed_and_cloned", setup)
+                    .assertion("control_install_projected_both_through_the_fakes", controlInstallProjected)
+                    .assertion("control_sync_projected_the_named_plugin", controlSyncLanded)
+                    .assertion("control_named_plugin_installed_into_both_agents", controlNamedInstalledInBothAgents)
+                    .assertion("control_absent_other_plugin_is_named_not_assumed", controlAbsentOtherIsNamed)
+                    .assertion("control_sync_with_no_unit_projects_both", controlSyncAll)
+                    .assertion("control_marketplace_still_lists_both", controlMarketplaceListsBoth)
+                    .assertion("shape_no_other_plugin_reprojected", shape)
+                    .log(detail + " | sync argvs: " + atSync);
+        });
+    }
+
+    static long names(List<String> lines, String plugin) {
+        return lines.stream().filter(l -> l.contains(plugin)).count();
+    }
+}
diff --git a/test_graph/sources/cheap-checks/InstallExclusion.java b/test_graph/sources/cheap-checks/InstallExclusion.java
new file mode 100644
index 00000000..e1d94145
--- /dev/null
+++ b/test_graph/sources/cheap-checks/InstallExclusion.java
@@ -0,0 +1,280 @@
+///usr/bin/env jbang "$0" "$@" ; exit $?
+//SOURCES ../../sdk/java/src/main/java/com/hayden/testgraphsdk/sdk/*.java
+//SOURCES ../lib/SmEnv.java
+//SOURCES CheapChecksKit.java
+
+import com.hayden.testgraphsdk.sdk.Node;
+import com.hayden.testgraphsdk.sdk.NodeResult;
+import com.hayden.testgraphsdk.sdk.NodeSpec;
+import com.hayden.testgraphsdk.sdk.ProcessRecord;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/**
+ * GOAL-excluded-paths-keep-git, #261: an install honours a manifest exclusion and the
+ * installed copy keeps every git function.
+ *
+ * <p>Fixture: a skill declaring an exclusion of {@code specs/.history} in its manifest,
+ * installed from a bare upstream with two commits touching the excluded path. No
+ * The upstream serves partial clones, so the install is a real promisor checkout.
+ *
+ * <p>Clauses, separately: (a) {@code shape_no_files_at_excluded_path}, the only one
+ * expected red at baseline (the count is the metric); (b) the seven operations on the
+ * installed unit, each its own assertion, including log/blame/diff on an excluded path;
+ * (c) a commit made in the unit leaves the excluded tree unchanged.
+ *
+ * <p>Clause (b)/(c) arms are expected GREEN today (an install is a full clone) and are
+ * the regression half: they exist so CC-5's partial/sparse clone is held to them.
+ */
+public class InstallExclusion {
+    static final String ID = "cheap.install-exclusion";
+    static final String UNIT = "cc-exclude-unit";
+    static final String EXCLUDED = "specs/.history";
+    static final String DECLARATION = "excluded_from_install = [\"" + EXCLUDED + "\"]";
+    static final NodeSpec SPEC = NodeSpec.of(ID)
+            .kind(NodeSpec.Kind.ASSERTION)
+            .dependsOn("env.prepared")
+            .tags("cheap-checks", "install", "261", "git")
+            .timeout("600s");
+
+    public static void main(String[] args) {
+        Node.run(args, SPEC, ctx -> {
+            Path root;
+            Path bare;
+            Path writer;
+            ProcessRecord install;
+            String baselineTree;
+            String advanced;
+            try {
+                root = CheapChecksKit.scratch(ctx, "install-exclusion");
+                writer = root.resolve("upstream");
+                bare = root.resolve("upstream.git");
+                CheapChecksKit.writeSkill(writer, UNIT, "0.1.0", "marker");
+                Files.writeString(writer.resolve("skill-manager.toml"), """
+                        [skill]
+                        name = "%s"
+                        version = "0.1.0"
+                        description = "cheap-checks graph fixture"
+                        %s
+                        """.formatted(UNIT, DECLARATION));
+                Files.createDirectories(writer.resolve(EXCLUDED));
+                Files.writeString(writer.resolve(EXCLUDED).resolve("a.txt"), "one\n");
+                Files.writeString(writer.resolve(EXCLUDED).resolve("b.txt"), "b\n");
+                CheapChecksKit.git(writer, "init", "-b", "main", "--quiet");
+                CheapChecksKit.commitAll(writer, "A");
+                Files.writeString(writer.resolve(EXCLUDED).resolve("a.txt"), "two\n");
+                CheapChecksKit.commitAll(writer, "B");
+                CheapChecksKit.git(root, "clone", "--quiet", "--bare", writer.toString(), bare.toString());
+                CheapChecksKit.git(bare, "config", "uploadpack.allowFilter", "true");
+                CheapChecksKit.git(writer, "remote", "add", "origin", bare.toString());
+                Path home = root.resolve("home");
+                CheapChecksKit.writePolicy(home);
+                install = CheapChecksKit.sm(ctx, "install", root, home,
+                        "install", "git+" + bare.toUri(), "--yes", "--no-bind-default");
+                baselineTree = CheapChecksKit.gitOut(writer, "ls-tree", "-r", "HEAD", "--", EXCLUDED);
+                Files.writeString(writer.resolve("later.txt"), "later\n");
+                CheapChecksKit.commitAll(writer, "C");
+                CheapChecksKit.git(writer, "push", "--quiet", "origin", "main");
+                advanced = CheapChecksKit.gitOut(writer, "rev-parse", "HEAD");
+            } catch (Exception e) {
+                return NodeResult.fail(ID, "setup failed: " + e).assertion("setup_ok", false);
+            }
+            Path unit = root.resolve("home/skills").resolve(UNIT);
+            boolean setupInstalled = install.exitCode() == 0 && Files.isDirectory(unit.resolve(".git"));
+            boolean controlKeptFilePresent = Files.isRegularFile(unit.resolve("SKILL.md"));
+            long excludedFiles;
+            try {
+                excludedFiles = CheapChecksKit.fileCount(unit.resolve(EXCLUDED));
+            } catch (Exception e) {
+                excludedFiles = -1;
+            }
+
+            // Before anything below faults a blob in: the object store really is partial.
+            String[] missingAtInstall = CheapChecksKit.gitTry(unit, "rev-list", "--objects", "--missing=print", "--all");
+            boolean blobsAbsent = ok(missingAtInstall) && missingAtInstall[1].lines().anyMatch(l -> l.startsWith("?"));
+
+            String aPath = EXCLUDED + "/a.txt";
+            String[] log = CheapChecksKit.gitTry(unit, "log", "--format=%h", "--", aPath);
+            String[] blame = CheapChecksKit.gitTry(unit, "blame", "HEAD", "--", aPath);
+            String[] diff = CheapChecksKit.gitTry(unit, "diff", "HEAD~1", "HEAD", "--", aPath);
+            String[] status = CheapChecksKit.gitTry(unit, "status", "--porcelain");
+            boolean logOk = ok(log) && log[1].lines().count() == 2;
+            boolean blameOk = ok(blame) && blame[1].contains("two");
+            boolean diffOk = ok(diff) && diff[1].contains("two") && diff[1].contains("one");
+            boolean statusOk = ok(status) && status[1].isEmpty();
+
+            String[] fetch = CheapChecksKit.gitTry(unit, "fetch", "origin", "main");
+            String fetchedHead = CheapChecksKit.gitTry(unit, "rev-parse", "FETCH_HEAD")[1];
+            boolean fetchOk = ok(fetch) && advanced.equals(fetchedHead);
+
+            boolean commitOk = false;
+            boolean pushOk = false;
+            boolean keepsTree = false;
+            String[] commit = {"-1", ""};
+            String[] push = {"-1", ""};
+            try {
+                Files.writeString(unit.resolve("new-in-install.txt"), "x\n");
+                CheapChecksKit.git(unit, "add", "new-in-install.txt");
+                commit = CheapChecksKit.gitTry(unit, "-c", "user.email=cc@local", "-c", "user.name=cc",
+                        "commit", "--quiet", "-m", "from the installed unit");
+                commitOk = ok(commit);
+                String afterTree = CheapChecksKit.gitOut(unit, "ls-tree", "-r", "HEAD", "--", EXCLUDED);
+                keepsTree = baselineTree.equals(afterTree) && !afterTree.isEmpty();
+                push = CheapChecksKit.gitTry(unit, "push", "origin", "HEAD:refs/heads/from-install");
+                pushOk = ok(push) && ok(CheapChecksKit.gitTry(bare, "rev-parse", "refs/heads/from-install"));
+            } catch (Exception e) {
+                // Reported below by the false assertions; the message is in the detail.
+                commit[1] = commit[1] + " " + e;
+            }
+
+            // What a sparse checkout tends to break: staging everything, stash, and a
+            // sync that merges an upstream commit touching the excluded path.
+            boolean addAllOk = false;
+            boolean addAllKeepsTree = false;
+            boolean stashOk = false;
+            boolean syncOk = false;
+            boolean syncStaysExcluded = false;
+            boolean syncTookExcludedChange = false;
+            boolean blameFetchedAfterSync = false;
+            ProcessRecord sync = null;
+            long excludedAfterSync = -1;
+            try {
+                String before = CheapChecksKit.gitOut(unit, "ls-tree", "-r", "HEAD", "--", EXCLUDED);
+                Files.writeString(unit.resolve("added-by-all.txt"), "y\n");
+                CheapChecksKit.git(unit, "add", "-A");
+                addAllOk = ok(CheapChecksKit.gitTry(unit, "-c", "user.email=cc@local", "-c", "user.name=cc",
+                        "commit", "--quiet", "-m", "after add -A"));
+                addAllKeepsTree = before.equals(CheapChecksKit.gitOut(unit, "ls-tree", "-r", "HEAD", "--", EXCLUDED));
+
+                Files.writeString(unit.resolve("SKILL.md"), CheapChecksKit.read(unit.resolve("SKILL.md")) + "dirty\n");
+                stashOk = ok(CheapChecksKit.gitTry(unit, "stash", "--quiet"))
+                        && ok(CheapChecksKit.gitTry(unit, "stash", "pop", "--quiet"))
+                        && CheapChecksKit.gitTry(unit, "status", "--porcelain")[1].contains("SKILL.md");
+                CheapChecksKit.git(unit, "checkout", "--quiet", "--", "SKILL.md");
+
+                Files.writeString(writer.resolve(EXCLUDED).resolve("a.txt"), "three\n");
+                CheapChecksKit.commitAll(writer, "D");
+                CheapChecksKit.git(writer, "push", "--quiet", "origin", "main");
+                sync = CheapChecksKit.sm(ctx, "sync", root, root.resolve("home"), "sync", UNIT, "--merge", "--yes");
+                syncOk = sync.exitCode() == 0;
+                excludedAfterSync = CheapChecksKit.fileCount(unit.resolve(EXCLUDED));
+                syncStaysExcluded = excludedAfterSync == 0;
+                String[] show = CheapChecksKit.gitTry(unit, "show", "HEAD:" + aPath);
+                syncTookExcludedChange = ok(show) && show[1].contains("three");
+                String[] blameAfter = CheapChecksKit.gitTry(unit, "blame", "HEAD", "--", aPath);
+                blameFetchedAfterSync = ok(blameAfter) && blameAfter[1].contains("three");
+            } catch (Exception e) {
+                commit[1] = commit[1] + " " + e;
+            }
+
+            // A source that ignores --filter keeps the working-tree exclusion and its blobs.
+            boolean fallbackExcluded = false;
+            boolean fallbackBlobsPresent = false;
+            boolean fallbackBlame = false;
+            // A unit declaring nothing is exactly the clone it always was.
+            boolean controlPlain = false;
+            try {
+                Path noFilter = root.resolve("no-filter.git");
+                CheapChecksKit.git(root, "clone", "--quiet", "--bare", writer.toString(), noFilter.toString());
+                Path fbHome = root.resolve("home-fallback");
+                CheapChecksKit.writePolicy(fbHome);
+                ProcessRecord fb = CheapChecksKit.sm(ctx, "install-fallback", root, fbHome,
+                        "install", "git+" + noFilter.toUri(), "--yes", "--no-bind-default");
+                Path fbUnit = fbHome.resolve("skills").resolve(UNIT);
+                fallbackExcluded = fb.exitCode() == 0 && CheapChecksKit.fileCount(fbUnit.resolve(EXCLUDED)) == 0;
+                String[] missing = CheapChecksKit.gitTry(fbUnit, "rev-list", "--objects", "--missing=print", "--all");
+                fallbackBlobsPresent = ok(missing) && missing[1].lines().noneMatch(l -> l.startsWith("?"));
+                fallbackBlame = ok(CheapChecksKit.gitTry(fbUnit, "blame", "HEAD", "--", aPath));
+
+                Path plainWriter = root.resolve("plain-upstream");
+                Path plainBare = root.resolve("plain.git");
+                CheapChecksKit.writeSkill(plainWriter, "cc-plain-unit", "0.1.0", "marker");
+                CheapChecksKit.git(plainWriter, "init", "-b", "main", "--quiet");
+                CheapChecksKit.commitAll(plainWriter, "A");
