+ * #410: a clean checkout's commit is its identity, and every way a clean status
+ * could be a claim the commit cannot back reads as "not clean".
+ */
+public final class GitOpsCleanCommitTest {
+
+    public static int run() throws Exception {
+        if (!GitOps.isAvailable()) {
+            System.out.println("== GitOpsCleanCommitTest — SKIPPED, git is not on PATH");
+            return 0;
+        }
+        return Tests.suite("GitOpsCleanCommitTest")
+
+                .test("a clean checkout answers its HEAD", () -> {
+                    Path r = repo();
+                    assertEquals(git(r, "rev-parse", "HEAD").trim(), clean(r), "HEAD");
+                })
+
+                .test("a non-checkout, and a directory inside someone's checkout, answer nothing", () -> {
+                    Path plain = Files.createTempDirectory("plain-");
+                    assertEquals("", clean(plain), "no repo");
+                    Path r = repo();
+                    Path nested = Files.createDirectories(r.resolve("nested"));
+                    assertEquals("", clean(nested), "must not answer for the enclosing repo");
+                })
+
+                .test("a tracked edit, an untracked file and a chmod are all not clean", () -> {
+                    Path r = repo();
+                    Files.writeString(r.resolve("a.txt"), "changed\n");
+                    assertEquals("", clean(r), "tracked edit");
+                    git(r, "checkout", "--", ".");
+                    Files.writeString(r.resolve("u.txt"), "x");
+                    assertEquals("", clean(r), "untracked");
+                    Files.delete(r.resolve("u.txt"));
+                    git(r, "config", "core.fileMode", "false");
+                    assertTrue(r.resolve("a.txt").toFile().setExecutable(true), "chmod");
+                    assertEquals("", clean(r), "chmod is content even with core.fileMode=false");
+                })
+
+                .test("an install-excluded path that is absent keeps the commit as identity", () -> {
+                    Path r = sparseRepo();
+                    assertEquals(git(r, "rev-parse", "HEAD").trim(), clean(r), "sparse install is clean");
+                })
+
+                .test("a file planted at an excluded path is not clean", () -> {
+                    Path r = sparseRepo();
+                    Files.createDirectories(r.resolve("excluded"));
+                    Files.writeString(r.resolve("excluded/x.txt"), "planted\n");
+                    assertEquals("", clean(r), "skip-worktree hides this from status");
+                })
+
+                .test("a user's skip-worktree on a kept path is still a hole, even when sparse", () -> {
+                    Path r = sparseRepo();
+                    git(r, "update-index", "--skip-worktree", "a.txt");
+                    Files.writeString(r.resolve("a.txt"), "edited behind status\n");
+                    assertEquals("", clean(r), "must not read clean");
+                    Path plain = repo();
+                    git(plain, "update-index", "--skip-worktree", "a.txt");
+                    assertEquals("", clean(plain), "no sparse checkout at all");
+                })
+
+                .test("a sparse checkout somebody else patterned is not trusted", () -> {
+                    Path r = sparseRepo();
+                    Files.writeString(r.resolve(".git/info/sparse-checkout"), "/a.txt\n");
+                    assertEquals("", clean(r), "not the shape an install writes");
+                })
+
+                .test("the user's untracked-files setting cannot hide an untracked file", () -> {
+                    Path r = repo();
+                    git(r, "config", "status.showUntrackedFiles", "no");
+                    Files.writeString(r.resolve("u.txt"), "x");
+                    assertEquals("", clean(r), "untracked despite the config");
+                })
+
+                .test("a committed gitignore hides its path; a global or local exclude does not", () -> {
+                    Path r = repo();
+                    Files.writeString(r.resolve("ignored.txt"), "x");
+                    assertEquals(git(r, "rev-parse", "HEAD").trim(), clean(r), "committed rule");
+
+                    Files.writeString(r.resolve("global.txt"), "x");
+                    Path global = Files.createTempFile("excludes-", "");
+                    Files.writeString(global, "global.txt\n");
+                    git(r, "config", "core.excludesFile", global.toString());
+                    assertEquals("", clean(r), "machine-level excludes are not identity");
+                    Files.delete(r.resolve("global.txt"));
+
+                    Files.writeString(r.resolve(".git/info/exclude"), "# a comment\n");
+                    assertEquals(git(r, "rev-parse", "HEAD").trim(), clean(r), "comments are not rules");
+                    Files.writeString(r.resolve(".git/info/exclude"), "local.txt\n");
+                    assertEquals("", clean(r), "info/exclude cannot be pinned, so it falls back");
+                })
+
+                .test("assume-unchanged and skip-worktree cannot hide an edit", () -> {
+                    Path r = repo();
+                    git(r, "update-index", "--assume-unchanged", "a.txt");
+                    assertEquals("", clean(r), "assume-unchanged");
+                    git(r, "update-index", "--no-assume-unchanged", "a.txt");
+                    git(r, "update-index", "--skip-worktree", "a.txt");
+                    assertEquals("", clean(r), "skip-worktree");
+                })
+
+                .test("a rename is not clean; a non-content path is", () -> {
+                    Path r = repo();
+                    git(r, "mv", "a.txt", "b.txt");
+                    assertEquals("", clean(r), "staged rename");
+                    git(r, "reset", "--hard", "--quiet");
+                    Files.createDirectories(r.resolve("x/__pycache__"));
+                    Files.writeString(r.resolve("x/__pycache__/c.pyc"), "x");
+                    assertEquals("", clean(r), "no predicate: it is a change");
+                    assertEquals(git(r, "rev-parse", "HEAD").trim(),
+                            GitOps.cleanCommit(r, rel -> rel.contains("__pycache__")).orElse(""),
+                            "the predicate clears it, even though only a nested file is untracked");
+                })
+
+                .test("a repository with no commit answers nothing", () -> {
+                    Path r = Files.createTempDirectory("empty-");
+                    git(r, "init", "-b", "main", "--quiet");
+                    assertEquals("", clean(r), "unborn HEAD");
+                })
+
+                .test("pruning keeps the directory a pruned child made non-empty", () -> {
+                    Path r = Files.createTempDirectory("prune-");
+                    Files.createDirectories(r.resolve("kept/.git"));
+                    Files.writeString(r.resolve("kept/.git/config"), "x");
+                    Files.createDirectories(r.resolve("empty"));
+                    Files.writeString(r.resolve("f.txt"), "x");
+                    var entries = ChildHomeMaterializer.entryDigests(r, Set.of(".git"));
+                    assertTrue(entries.containsKey("kept"), "dir with only a pruned child stays: " + entries.keySet());
+                    assertTrue(entries.containsKey("empty"), "an authored empty dir stays");
+                    assertTrue(entries.containsKey("f.txt"), "files stay");
+                    assertFalse(entries.keySet().stream().anyMatch(k -> k.contains(".git")), "pruned");
+                })
+
+                .runAll();
+    }
+
+    private static String clean(Path r) {
+        return GitOps.cleanCommit(r, rel -> false).orElse("");
+    }
+
+    private static Path repo() throws Exception {
+        Path r = Files.createTempDirectory("clean-commit-");
+        Files.writeString(r.resolve("a.txt"), "a\n");
+        Files.writeString(r.resolve(".gitignore"), "ignored.txt\n");
+        git(r, "init", "-b", "main", "--quiet");
+        git(r, "add", "-A");
+        git(r, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "--quiet", "-m", "A");
+        return r;
+    }
+
+    private static Path sparseRepo() throws Exception {
+        Path r = Files.createTempDirectory("clean-commit-sparse-");
+        Files.writeString(r.resolve("a.txt"), "a\n");
+        Files.createDirectories(r.resolve("excluded"));
+        Files.writeString(r.resolve("excluded/x.txt"), "x\n");
+        git(r, "init", "-b", "main", "--quiet");
+        git(r, "add", "-A");
+        git(r, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "--quiet", "-m", "A");
+        assertTrue(SparseInstall.apply(r, List.of("excluded")), "sparse-checkout set");
+        return r;
+    }
+
+    private static String git(Path dir, String... args) throws Exception {
+        List<String> argv = new ArrayList<>(List.of("git"));
+        argv.addAll(List.of(args));
+        Process p = new ProcessBuilder(argv).directory(dir.toFile()).redirectErrorStream(true).start();
+        String out = new String(p.getInputStream().readAllBytes());
+        assertEquals(0, p.waitFor(), "git " + argv + ": " + out);
+        return out;
+    }
+}
diff --git a/src/test/java/dev/skillmanager/source/GitOpsIndexRefreshTest.java b/src/test/java/dev/skillmanager/source/GitOpsIndexRefreshTest.java
new file mode 100644
index 00000000..a70f3df7
--- /dev/null
+++ b/src/test/java/dev/skillmanager/source/GitOpsIndexRefreshTest.java
@@ -0,0 +1,165 @@
+package dev.skillmanager.source;
+
+import dev.skillmanager._lib.test.Tests;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.ArrayList;
+import java.util.List;
+
+import static dev.skillmanager._lib.test.Tests.assertContains;
+import static dev.skillmanager._lib.test.Tests.assertEquals;
+import static dev.skillmanager._lib.test.Tests.assertFalse;
+import static dev.skillmanager._lib.test.Tests.assertTrue;
+
+/**
+ * #450: a copied checkout's index is refreshed without changing what it describes,
+ * and {@link GitOps#cleanTree} answers only for a subtree HEAD really holds.
+ */
+public final class GitOpsIndexRefreshTest {
+
+    public static int run() throws Exception {
+        if (!GitOps.isAvailable()) {
+            System.out.println("== GitOpsIndexRefreshTest — SKIPPED, git is not on PATH");
+            return 0;
+        }
+        return Tests.suite("GitOpsIndexRefreshTest")
+
+                .test("a copy is stat-stale until refreshed, and refreshing changes no file", () -> {
+                    Path copy = copyOf(repo());
+                    assertFalse(git(copy, "diff-files").isBlank(), "the copy's index is stale as copied");
+                    byte[] before = Files.readAllBytes(copy.resolve("a.txt"));
+
+                    assertEquals(null, GitOps.refreshIndex(copy), "refreshed");
+
+                    assertEquals("", git(copy, "diff-files"), "no entry needs re-hashing");
+                    assertEquals("", git(copy, "status", "--porcelain"), "still clean");
+                    assertTrue(java.util.Arrays.equals(before, Files.readAllBytes(copy.resolve("a.txt"))),
+                            "tracked bytes untouched");
+                })
+
+                .test("an edit after a refresh is still seen", () -> {
+                    Path copy = copyOf(repo());
+                    GitOps.refreshIndex(copy);
+                    Files.writeString(copy.resolve("a.txt"), "b\n");
+                    assertContains(git(copy, "status", "--porcelain"), "a.txt", "same size, new content");
+                })
+
+                .test("a sparse checkout's excluded paths stay absent and stay skip-worktree", () -> {
+                    Path r = sparseRepo();
+                    Path copy = copyOf(r);
+                    assertEquals(null, GitOps.refreshIndex(copy), "refreshed");
+                    assertFalse(Files.exists(copy.resolve("excluded/x.txt")), "still absent");
+                    assertContains(git(copy, "ls-files", "-v", "excluded"), "S excluded/x.txt", "still skip-worktree");
+                    assertEquals("", git(copy, "status", "--porcelain"), "clean");
+                })
+
+                .test("a partial clone fetches no blob", () -> {
+                    Path origin = repo();
+                    git(origin, "config", "uploadpack.allowfilter", "true");
+                    Path parent = Files.createTempDirectory("index-refresh-partial-");
+                    Path clone = parent.resolve("c");
+                    git(parent, "clone", "--quiet", "--filter=blob:none", "--no-checkout",
+                            "file://" + origin.toRealPath(), clone.toString());
+                    assertTrue(SparseInstall.apply(clone, List.of("excluded")), "sparse-checkout set");
+                    git(clone, "checkout", "--quiet", "main");
+                    Path copy = copyOf(clone);
+                    git(copy, "remote", "set-url", "origin", "file:///nonexistent/remote");
+                    String objects = git(copy, "count-objects", "-v");
+
+                    assertEquals(null, GitOps.refreshIndex(copy), "refreshed with no remote reachable");
+                    assertEquals(objects, git(copy, "count-objects", "-v"), "no object was fetched");
+                })
+
+                .test("a .git file pointing at another checkout is refused, and that index is untouched", () -> {
+                    Path other = repo();
+                    Path index = other.resolve(".git/index");
+                    long stamp = Files.getLastModifiedTime(index).toMillis();
+                    byte[] bytes = Files.readAllBytes(index);
+                    Path foreign = Files.createTempDirectory("index-refresh-foreign-");
+                    Files.writeString(foreign.resolve(".git"), "gitdir: " + other.resolve(".git") + "\n");
+
+                    assertTrue(GitOps.refreshIndex(foreign) != null, "refused");
+                    assertEquals(stamp, Files.getLastModifiedTime(index).toMillis(), "index not rewritten");
+                    assertTrue(java.util.Arrays.equals(bytes, Files.readAllBytes(index)), "index bytes same");
+                })
+
+                .test("a held index.lock fails open with a reason", () -> {
+                    Path copy = copyOf(repo());
+                    Files.writeString(copy.resolve(".git/index.lock"), "");
+                    assertTrue(GitOps.refreshIndex(copy) != null, "a reason, not an exception");
+                    assertEquals("a\n", Files.readString(copy.resolve("a.txt")), "checkout intact");
+                })
+
+                .test("cleanTree names the subtree, ignoring edits elsewhere and refusing edits inside", () -> {
+                    Path r = repo();
+                    String tree = git(r, "rev-parse", "HEAD:scripts").trim();
+                    assertEquals(tree, GitOps.cleanTree(r, "scripts").orElse(""), "clean subtree");
+
+                    Files.writeString(r.resolve("a.txt"), "elsewhere\n");
+                    assertEquals(tree, GitOps.cleanTree(r, "scripts").orElse(""), "an edit outside does not matter");
+                    git(r, "checkout", "--", ".");
+
+                    Files.writeString(r.resolve("scripts/s.sh"), "edited\n");
+                    assertEquals("", GitOps.cleanTree(r, "scripts").orElse(""), "tracked edit");
+                    git(r, "checkout", "--", ".");
+
+                    Files.writeString(r.resolve("scripts/new.sh"), "new\n");
+                    assertEquals("", GitOps.cleanTree(r, "scripts").orElse(""), "untracked file");
+                    Files.delete(r.resolve("scripts/new.sh"));
+
+                    git(r, "update-index", "--assume-unchanged", "scripts/s.sh");
+                    assertEquals("", GitOps.cleanTree(r, "scripts").orElse(""), "assume-unchanged hides nothing");
+                    git(r, "update-index", "--no-assume-unchanged", "scripts/s.sh");
+
+                    assertEquals("", GitOps.cleanTree(r, "absent").orElse(""), "not in HEAD");
+                    assertEquals("", GitOps.cleanTree(r, "").orElse(""), "no subtree named");
+                })
+
+                .runAll();
+    }
+
+    private static Path repo() throws Exception {
+        Path r = Files.createTempDirectory("index-refresh-");
+        Files.writeString(r.resolve("a.txt"), "a\n");
+        Files.createDirectories(r.resolve("scripts"));
+        Files.writeString(r.resolve("scripts/s.sh"), "s\n");
+        git(r, "init", "-b", "main", "--quiet");
+        git(r, "add", "-A");
+        git(r, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "--quiet", "-m", "A");
+        return r;
+    }
+
+    private static Path sparseRepo() throws Exception {
+        Path r = repo();
+        Files.createDirectories(r.resolve("excluded"));
+        Files.writeString(r.resolve("excluded/x.txt"), "x\n");
+        git(r, "add", "-A");
+        git(r, "-c", "user.name=t", "-c", "user.email=t@t", "commit", "--quiet", "-m", "B");
+        assertTrue(SparseInstall.apply(r, List.of("excluded")), "sparse-checkout set");
+        return r;
+    }
+
+    /** A copy the way a clone makes one: new inodes, mtimes kept. */
+    private static Path copyOf(Path source) throws Exception {
+        Path target = Files.createTempDirectory("index-refresh-copy-");
+        try (var walk = Files.walk(source)) {
+            for (Path p : walk.toList()) {
+                Path to = target.resolve(source.relativize(p).toString());
+                if (Files.isDirectory(p)) Files.createDirectories(to);
+                else Files.copy(p, to, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.COPY_ATTRIBUTES);
+            }
+        }
+        return target;
+    }
+
+    private static String git(Path dir, String... args) throws Exception {
+        List<String> argv = new ArrayList<>(List.of("git"));
+        argv.addAll(List.of(args));
+        Process p = new ProcessBuilder(argv).directory(dir.toFile()).redirectErrorStream(true).start();
+        String out = new String(p.getInputStream().readAllBytes());
+        assertEquals(0, p.waitFor(), "git " + argv + ": " + out);
+        return out;
+    }
+}
