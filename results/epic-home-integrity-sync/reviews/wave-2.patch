+- id: HIS-7
+  title: '`build` reports a shim it did not write, because presence is decided by what runs rather than
+    what this home owns'
+  phase: HIS
+  status: next
+  epic: home-integrity-sync
+  github_issue: 223
+  added_in_schedule_revision: 2
+  wave: 2
+  depends_on: []
