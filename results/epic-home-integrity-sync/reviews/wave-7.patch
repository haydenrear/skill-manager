+        record("V4b", "the membership law stops reading orphaned .projections.json records",
+               "HomeMembershipLaw.installedRecords: the .projections.json arm returns "
+               "without recording the name",
+               ["the_detector_flags_a_planted_gain_and_a_planted_loss"],
+               base_law, after,
