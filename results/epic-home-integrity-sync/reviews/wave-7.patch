+THE HARNESS
+-----------
+#!/usr/bin/env python3
+"""HIS-16 vacuity probes.
+
+DEF-035 discipline, applied literally:
+  * the tree is COMMITTED before anything is mutated, and the revert is from a
+    saved byte copy taken here — never `git checkout --`, which restores to HEAD
+    and has eaten uncommitted work twice in this epic;
+  * every mutation asserts its pattern matched EXACTLY ONCE before it is
+    applied, so a mutation that matched nothing cannot read as a passing check;
+  * the reddened ASSERTION NAMES are recorded, not just "it went red", because
+    mechanism A in the epic's ledger is a probe that reddens a precondition.
+
+DELIBERATELY NOT PROBED HERE: JsonContractTest. It now drives the four project
+verbs on their real execution paths, and with the guard mutated away that does
+not go red — it reproduces DEF-047 against this worktree's own home. See
+RunHis16.java's javadoc.
+"""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+REPO = "/Users/hayde/IdeaProjects/wt-237-his-16"
+SCRATCH = os.path.dirname(os.path.abspath(__file__))
+LAWPROBE = os.path.join(SCRATCH, "lawprobe")
+
+
+def run(cmd, cwd=REPO, timeout=900):
+    p = subprocess.run(cmd, cwd=cwd, shell=True, capture_output=True,
+                       text=True, timeout=timeout)
+    return p.returncode, p.stdout + p.stderr
+
+
+def unit_lane():
+    """RunHis16 -> {case label: 'PASS'|'FAIL'}."""
+    rc, out = run("jbang RunHis16.java")
+    cases = {}
+    for line in out.split("\n"):
+        line = line.strip()
+        if line.startswith("[PASS] "):
+            cases[line[7:]] = "PASS"
+        elif line.startswith("[FAIL] "):
+            cases[line[7:].split(": ")[0]] = "FAIL"
+    return rc, cases, out
+
+
+def law_lane():
+    """The membership law standalone -> {assertion: status}."""
+    os.makedirs(LAWPROBE, exist_ok=True)
+    result = os.path.join(LAWPROBE, "result.json")
+    if os.path.exists(result):
+        os.remove(result)
+    run("jbang sources/common/HomeMembershipLaw.java "
+        "--nodeId=home.membership.law --reportDir=%s --result-out=%s"
+        % (LAWPROBE, result), cwd=os.path.join(REPO, "test_graph"))
+    with open(result) as fh:
+        d = json.load(fh)
+    return ({a["name"]: a["status"] for a in d.get("assertions", [])},
+            "\n".join(d.get("logs", [])))
+
+
+class Mutation:
+    def __init__(self, path, old, new):
+        self.path = os.path.join(REPO, path)
+        self.old = old
+        self.new = new
+        self.backup = None
+
+    def __enter__(self):
+        with open(self.path) as fh:
+            s = fh.read()
+        n = s.count(self.old)
+        # Mechanism C, stated as an assertion rather than a hope.
+        assert n == 1, "MUTATION PATTERN matched %d times in %s (must be 1)" % (n, self.path)
+        fd, self.backup = tempfile.mkstemp(suffix=".bak")
+        os.close(fd)
+        shutil.copyfile(self.path, self.backup)
+        with open(self.path, "w") as fh:
+            fh.write(s.replace(self.old, self.new))
+        return self
+
+    def __exit__(self, *a):
+        shutil.copyfile(self.backup, self.path)
+        os.remove(self.backup)
+        return False
+
+
+REPORT = []
+
+
+def record(v, what, mutation, expected, before, after, extra=""):
+    reddened = sorted(k for k in after if after[k] != before.get(k, after[k]))
+    ok = sorted(expected) == reddened
+    REPORT.append(
+        "%s  %s\n"
+        "    mutation: %s\n"
+        "    expected to redden: %s\n"
+        "    ACTUALLY reddened:  %s\n"
+        "    verdict: %s%s\n"
+        % (v, what, mutation, expected or "(nothing)", reddened or "(nothing)",
+           "the claim reddened, and only the claim" if ok
+           else "MISMATCH — read this before trusting the probe",
+           ("\n    " + extra) if extra else ""))
+    return ok
+
+
+def main():
+    rc, base_unit, _ = unit_lane()
+    assert rc == 0, "BASELINE unit lane is not green; probes are meaningless"
+    base_law, base_log = law_lane()
+    REPORT.append("BASELINE\n    RunHis16: %d cases, all PASS\n"
+                  "    membership law self-test: %s\n"
+                  % (len(base_unit),
+                     base_law.get("the_detector_flags_a_planted_gain_and_a_planted_loss")))
+
+    # ---- V1: the confinement check in ProjectRoot never fires ---------------
+    with Mutation(
+            "src/main/java/dev/skillmanager/project/ProjectRoot.java",
+            "        if (!confinement.covers(root)) {",
+            "        if (false) {   // V1: the guard removed"):
+        _, after, _ = unit_lane()
+        record("V1", "the CWD/confinement check in ProjectRoot removed",
+               "ProjectRoot.resolve: `if (!confinement.covers(root))` -> `if (false)`",
+               ["a confined process refuses a CWD-derived root outside the root",
+                "an explicit --project-dir OUTSIDE the root is refused too"],
+               base_unit, after)
+
+    # ---- V2: the CWD axis dropped from the one call -------------------------
+    with Mutation(
+            "src/main/java/dev/skillmanager/sandbox/Confinement.java",
+            "        axes.add(axis(CWD, workingDirectory(), normalizedRoot));",
+            "        // V2: the cwd axis dropped"):
+        _, after, _ = unit_lane()
+        record("V2", "the working-directory axis dropped from Confinement.current()",
+               "Confinement.current: the `axes.add(axis(CWD, ...))` line deleted",
+               ["every axis is read, and the working directory is one of them"],
+               base_unit, after,
+               "This is the scope-2 claim itself: a sandbox report that does not "
+               "cover CWD is the pre-#237 state, where five variables were pinned "
+               "and the sixth axis was never asked about.")
+
+    # ---- V3: an unset axis read as confined ---------------------------------
+    with Mutation(
+            "src/main/java/dev/skillmanager/sandbox/Confinement.java",
+            "        boolean inside = root != null && normalized != null && normalized.startsWith(root);",
+            "        boolean inside = root == null || normalized == null || normalized.startsWith(root);"):
+        _, after, _ = unit_lane()
+        record("V3", "an UNSET axis treated as confined rather than as an escape",
+               "Confinement.axis: a null value now reads as inside",
+               ["an UNSET agent variable is an escape, not a pass"],
+               base_unit, after,
+               "SmEnv's class comment records what an unset agent root costs: "
+               "five units projected into three real agent homes.")
+
+    # ---- V4: the law stops counting orphaned .projections.json --------------
+    # FIRST ATTEMPT. Its DIAGNOSIS was wrong and is corrected here; review of
+    # #241, M3. The mutation reddened nothing, and the reason recorded was
+    # "benign redundancy -- the sibling .json branch catches it under a mangled
+    # name". That was true only because the fixtures had ONE .projections.json
+    # in the whole lane: the orphan the "lost" home plants, the single file for
+    # which the mangled name still lands in the right bucket. A real home has
+    # one beside every LIVE unit, and under this mutation each becomes a
+    # spurious LOST. So it is not benign -- it is a MASS FALSE POSITIVE, and the
+    # fixture could not express it. Mechanism B, occurring inside the instrument
+    # built to count mechanism B. plant() now writes a .projections.json beside
+    # every live unit, so this row re-measures against a fixture that can.
+    with Mutation(
