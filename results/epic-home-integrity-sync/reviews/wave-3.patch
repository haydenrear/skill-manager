+- id: HIS-9
+  title: nothing refuses a write outside the home SKILL_MANAGER_HOME names -- the class behind repeated
+    root-home damage
+  phase: HIS
+  status: planned
+  epic: home-integrity-sync
+  github_issue: 226
+  added_in_schedule_revision: 4
+  wave: 4
+  depends_on:
