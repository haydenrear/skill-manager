+/**
+ * The suite HIS-15 (#235) added, on its own.
+ *
+ * <p>SHIPPED ON PURPOSE, for the reason RunHis11.java and RunHis12.java are:
+ * every record in results/epic-home-integrity-sync/probes/his-15/
+ * vacuity-checks.txt names this runner, and a record naming a file that does
+ * not exist is a claim rather than evidence. Apply the mutation a V-number
+ * names, run this, revert.
+ *
+ * <p>jbang RunTests.java remains the full suite and the ticket's declared
+ * local signal; this is the one suite, seconds instead of minutes. It drives
+ * all 31 commands that declare --json through the real CLI entry point, so it
+ * is slower than a pure unit test and still far faster than the graph.
+ */
+public class RunHis15 {
+    public static void main(String[] a) throws Exception {
+        int f = dev.skillmanager.cli.JsonContractTest.run();
+        System.out.println(f == 0 ? "\nALL PASSED" : "\nFAILURES: " + f);
+        if (f != 0) System.exit(1);
+    }
+}
